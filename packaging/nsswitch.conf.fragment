# Merge into /etc/nsswitch.conf hosts: line (do not wipe vendor file blindly)
# RustD-Resolved synthesizes localhost and the machine hostname itself, so a
# separate nss-myhostname module is not required for a systemd-libs-free host.
# Recommended Fedora/RHEL cutover line:
hosts: files rustd_dns [!UNAVAIL=return] dns

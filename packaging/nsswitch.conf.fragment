# Merge into /etc/nsswitch.conf hosts: line (do not wipe vendor file blindly)
# `myhostname` requires a separate nss-myhostname provider; rustd-resolved
# does not currently ship one.
# Recommended (Fedora/RHEL style):
# hosts: files myhostname mdns4_minimal [NOTFOUND=return] rustd_dns [!UNAVAIL=return] dns
hosts: files myhostname rustd_dns [!UNAVAIL=return] dns

[Unit]
Description=RustD Network Name Resolver
Documentation=man:rustd-resolved(8)
Documentation=man:org.freedesktop.resolve1(5)
DefaultDependencies=no
Conflicts=systemd-resolved.service shutdown.target initrd-switch-root.target
After=rustd-sysusers.service dbus.service network-pre.target
Requires=dbus.service rustd-sysusers.service
Wants=dbus.service nss-lookup.target
Before=network.target nss-lookup.target NetworkManager.service multi-user.target
Wants=nss-lookup.target

[Service]
Type=notify
ExecStart=/usr/lib/rustd/rustd-resolved --dbus
Restart=on-failure
RestartSec=1s
LimitNOFILE=524288
# These transition-only capabilities let the daemon take ownership of the
# RustD-created runtime/state directories and complete its audited UID/GID
# change; resolved_drop_privileges() removes them before serving requests.
AmbientCapabilities=CAP_CHOWN CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_CHOWN CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=false
PrivateTmp=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths=/run/rustd /var/lib/rustd/resolved -/run/NetworkManager
RuntimeDirectory=rustd/resolve
RuntimeDirectoryMode=0755
StateDirectory=rustd/resolved
StateDirectoryMode=0750
Sockets=rustd-resolved-varlink.socket rustd-resolved-monitor.socket

[Install]
WantedBy=basic.target
Also=nss-lookup.target rustd-resolved-varlink.socket rustd-resolved-monitor.socket
Alias=dbus-org.freedesktop.resolve1.service

[Unit]
Description=RustD Network Name Resolver
Documentation=man:rustd-resolved(8)
Conflicts=systemd-resolved.service
After=rustd-sysusers.service network-pre.target
Before=network.target nss-lookup.target multi-user.target
Wants=nss-lookup.target

[Service]
Type=notify
ExecStart=/usr/lib/rustd/rustd-resolved --dbus
Restart=on-failure
RestartSec=1s
LimitNOFILE=524288
NoNewPrivileges=yes
# RustD does not yet realize ReadWritePaths= exceptions after ProtectSystem=strict
# remounts the service namespace read-only. Keep system trees protected while
# leaving /var available to normal DAC so RFC5011 state can be persisted in the
# rustd-resolve-owned 0750 /var/lib/rustd/resolved directory. Return this to
# ProtectSystem=strict when RustD's native ReadWritePaths= execution path lands.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths=/run/rustd /var/lib/rustd/resolved
RuntimeDirectory=rustd/resolve
RuntimeDirectoryMode=0755

[Install]
WantedBy=sysinit.target
Also=nss-lookup.target
